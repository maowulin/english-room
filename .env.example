# App-only public client config. Never put Tencent SecretKey or server secrets here.
# SDKAppID + short-lived UserSig come from Backend POST /v1/rooms/{room_id}/rtc-grants.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# demo | real | web — Fake RTC only for demo/test/web; real requires native TRTC development build.
EXPO_PUBLIC_MEDIA_MODE=demo
